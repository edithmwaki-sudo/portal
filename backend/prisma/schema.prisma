// Prisma schema — Apex ERP backend
// DB: PostgreSQL. Existing RBAC tables are preserved (roles, permissions, permission_role)
// and extended with the auth subsystem tables from backend/prompt.txt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// EXISTING RBAC TABLES (kept as-is, only indexed/relations added)
// =============================================================

model Role {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(50)
  displayName String             @map("display_name") @db.VarChar(100)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(100)
  description String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int           @map("role_id")
  permissionId Int           @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("permission_role")
}

// =============================================================
// USERS + STAFF (from prompt.txt existing tables)
// =============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrolmentStatus {
  ENROLLED
  WITHDRAWN
  COMPLETED
  TRANSFERRED
}

model User {
  id                      Int        @id @default(autoincrement())
  roleId                  Int?       @map("role_id")
  username                String     @unique @db.VarChar(100)
  email                   String     @unique @db.VarChar(255)
  phone                   String?    @db.VarChar(50)
  password                String     @db.VarChar(255)
  name                    String     @db.VarChar(255)
  firstName               String?    @map("first_name") @db.VarChar(100)
  middleName              String?    @map("middle_name") @db.VarChar(100)
  lastName                String?    @map("last_name") @db.VarChar(100)
  gender                  Gender?    @default(OTHER)
  dateOfBirth             DateTime?  @map("date_of_birth") @db.Date
  nationality             String?    @db.VarChar(100)
  county                  String?    @db.VarChar(100)
  placeOfBirth            String?    @map("place_of_birth") @db.VarChar(100)
  religion                String?    @db.VarChar(100)
  address                 String?    @db.Text
  city                    String?    @db.VarChar(100)
  postalCode              String?    @map("postal_code") @db.VarChar(20)
  profilePicture          String?    @map("profile_picture") @db.Text
  alternativePhoneNumber  String?    @map("alternative_phone_number") @db.VarChar(50)
  isPwd                   Boolean    @default(false) @map("is_pwd")
  disabilityType          String?    @map("disability_type") @db.VarChar(100)
  disabilityDescription   String?    @map("disability_description") @db.Text
  mustResetPassword       Boolean    @default(false) @map("must_reset_password")
  refreshTokenHash        String?    @map("refresh_token_hash") @db.Text
  passwordChangedAt       DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  failedLoginAttempts     Int        @default(0) @map("failed_login_attempts")
  lastFailedLoginAt       DateTime?  @map("last_failed_login_at") @db.Timestamptz(6)
  lockedUntil             DateTime?  @map("locked_until") @db.Timestamptz(6)
  twoFactorEnabled        Boolean    @default(false) @map("two_factor_enabled")
  status                  UserStatus @default(ACTIVE)
  lastLoginAt             DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp             String?    @map("last_login_ip") @db.VarChar(50)
  lastLoginUserAgent      String?    @map("last_login_user_agent") @db.Text
  emailVerifiedAt         DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdBy               Int?       @map("created_by")
  updatedBy               Int?       @map("updated_by")
  deletedAt               DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  role        Role?        @relation(fields: [roleId], references: [id])
  staffProfile StaffProfile?
  studentProfile StudentProfile?
  sessions    Session[]
  loginAttempts LoginAttempt[]
  auditLogs   AuditLog[]
  otpCodes    OtpCode[]

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model StaffProfile {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique @map("user_id")
  employeeNumber       String?   @unique @map("employee_number") @db.VarChar(50)
  nationalId           String?   @map("national_id") @db.VarChar(50)
  kraPin                String?   @map("kra_pin") @db.VarChar(50)
  nhifNumber            String?   @map("nhif_number") @db.VarChar(50)
  nssfNumber            String?   @map("nssf_number") @db.VarChar(50)
  departmentId          Int?      @map("department_id")
  supervisorId          Int?      @map("supervisor_id")
  jobTitle              String?   @map("job_title") @db.VarChar(100)
  employmentType        String?   @map("employment_type") @db.VarChar(50)
  employmentStatus      String?   @map("employment_status") @db.VarChar(50)
  dateJoined            DateTime? @map("date_joined") @db.Date
  confirmationDate      DateTime? @map("confirmation_date") @db.Date
  contractEndDate       DateTime? @map("contract_end_date") @db.Date
  terminationDate       DateTime? @map("termination_date") @db.Date
  terminationReason     String?   @map("termination_reason") @db.Text
  basicSalary           Decimal?  @map("basic_salary") @db.Decimal(12, 2)
  workEmail             String?   @map("work_email") @db.VarChar(255)
  workPhone             String?   @map("work_phone") @db.VarChar(50)
  officeLocation        String?   @map("office_location") @db.VarChar(100)
  isTeachingStaff       Boolean   @default(false) @map("is_teaching_staff")
  trainerNumber         String?   @map("trainer_number") @db.VarChar(50)
  highestQualification  String?   @map("highest_qualification") @db.VarChar(100)
  specialization        String?   @db.VarChar(255)
  nextOfKinFirstName    String?   @map("next_of_kin_first_name") @db.VarChar(100)
  nextOfKinLastName     String?   @map("next_of_kin_last_name") @db.VarChar(100)
  nextOfKinPhone        String?   @map("next_of_kin_phone") @db.VarChar(50)
  nextOfKinAltPhone     String?   @map("next_of_kin_alt_phone") @db.VarChar(50)
  nextOfKinEmail        String?   @map("next_of_kin_email") @db.VarChar(255)
  nextOfKinRelationship String?   @map("next_of_kin_relationship") @db.VarChar(100)
  nextOfKinName         String?   @map("next_of_kin_name") @db.VarChar(255)
  createdBy             Int?      @map("created_by")
  updatedBy             Int?      @map("updated_by")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department? @relation("StaffDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  headOfDepartments Department[] @relation("DepartmentHead")
  timetables AcademicTimetable[] @relation("TrainerTimetables")
  attendanceRecords ClassAttendance[] @relation("TrainerAttendance")

  @@index([departmentId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("staff_profiles")
}

// Academic setup: institutional departments (legacy: departments table).
model Department {
  id                 Int       @id @default(autoincrement())
  code               String    @unique @map("code") @db.VarChar(50)
  name               String    @unique @map("name") @db.VarChar(255)
  headOfDepartmentId Int?      @map("head_of_department_id")
  description        String?   @map("description") @db.Text
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  headOfDepartment StaffProfile? @relation("DepartmentHead", fields: [headOfDepartmentId], references: [id], onDelete: SetNull)
  staff            StaffProfile[] @relation("StaffDepartment")
  courses          Course[] @relation("DepartmentCourses")

  @@index([headOfDepartmentId])
  @@index([name])
  @@index([deletedAt])
  @@map("departments")
}

// Academic setup: certification authorities & their levels/grades
// (legacy: certification_authorities / certification_levels /
// certification_authority_grades tables).
model CertificationAuthority {
  id          Int       @id @default(autoincrement())
  code        String    @unique @map("code") @db.VarChar(50)
  name        String    @unique @map("name") @db.VarChar(255)
  description String?   @map("description") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   Int?      @map("created_by")
  updatedBy   Int?      @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  levels CertificationLevel[] @relation("AuthorityLevels")
  grades CertificationAuthorityGrade[] @relation("AuthorityGrades")
  curriculums Curriculum[] @relation("AuthorityCurricula")
  courses Course[] @relation("AuthorityCourses")

  @@index([isActive])
  @@index([name])
  @@index([createdAt])
  @@map("certification_authorities")
}

model CertificationLevel {
  id                       Int      @id @default(autoincrement())
  certificationAuthorityId Int      @map("certification_authority_id")
  code                     String   @map("code") @db.VarChar(50)
  name                     String   @map("name") @db.VarChar(100)
  entryGrade               String?  @map("entry_grade") @db.VarChar(100)
  description              String?  @map("description") @db.Text
  isActive                 Boolean  @default(true) @map("is_active")
  createdBy                Int?     @map("created_by")
  updatedBy                Int?     @map("updated_by")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  authority CertificationAuthority @relation("AuthorityLevels", fields: [certificationAuthorityId], references: [id], onDelete: Cascade)
  courses Course[] @relation("LevelCourses")

  @@unique([certificationAuthorityId, code])
  @@unique([certificationAuthorityId, name])
  @@index([certificationAuthorityId, isActive])
  @@index([createdAt])
  @@map("certification_levels")
}

model CertificationAuthorityGrade {
  id                       Int     @id @default(autoincrement())
  certificationAuthorityId Int     @map("certification_authority_id")
  grade                    String  @map("grade") @db.VarChar(50)
  gradeStart               Decimal @map("grade_start") @db.Decimal(5, 2)
  gradeEnd                 Decimal @map("grade_end") @db.Decimal(5, 2)
  remark                   String? @map("remark") @db.Text
  isActive                 Boolean @default(true) @map("is_active")
  createdBy                Int?    @map("created_by")
  updatedBy                Int?    @map("updated_by")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  authority CertificationAuthority @relation("AuthorityGrades", fields: [certificationAuthorityId], references: [id], onDelete: Cascade)

  @@unique([certificationAuthorityId, grade])
  @@index([certificationAuthorityId, isActive])
  @@index([certificationAuthorityId, gradeStart, gradeEnd])
  @@index([createdAt])
  @@map("certification_authority_grades")
}

// Academic setup: curricula tied to a certification authority. A curriculum
// is activated/deactivated via an active toggle; startedAt / endedAt are
// generated server-side on activation/deactivation.
model Curriculum {
  id                       Int      @id @default(autoincrement())
  certificationAuthorityId Int      @map("certification_authority_id")
  cycleName                String   @unique @map("cycle_name") @db.VarChar(100)
  isActive                 Boolean  @default(false) @map("is_active")
  startedAt                DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt                  DateTime? @map("ended_at") @db.Timestamptz(6)
  createdBy                Int?     @map("created_by")
  updatedBy                Int?     @map("updated_by")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  authority CertificationAuthority @relation("AuthorityCurricula", fields: [certificationAuthorityId], references: [id], onDelete: Cascade)

  courseCurricula CourseCurriculum[] @relation("CurriculumCourseCurricula")
  units           Unit[]            @relation("CurriculumUnits")
  feeAssignments  CourseFeeAssignment[] @relation("CurriculumFeeAssignments")
  invoices        Invoice[]         @relation("CurriculumInvoiceSource")

  @@index([certificationAuthorityId, isActive])
  @@index([createdAt])
  @@map("curriculum")
}

// Academic setup: courses tied to a certification authority/level and a home
// department. Courses are soft-deleted; a course is offered only through an
// active course_curricula mapping.
model Course {
  id                       Int       @id @default(autoincrement())
  code                     String    @unique @map("code") @db.VarChar(50)
  initials                 String    @map("initials") @db.VarChar(20)
  name                     String    @unique @map("name") @db.VarChar(255)
  durationMonths           Int?      @map("duration_months")
  description              String?   @map("description") @db.Text
  isActive                 Boolean   @default(true) @map("is_active")
  certificationAuthorityId Int?      @map("certification_authority_id")
  certificationLevelId     Int?      @map("certification_level_id")
  departmentId             Int?      @map("department_id")
  createdBy                Int?      @map("created_by")
  updatedBy                Int?      @map("updated_by")
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  authority CertificationAuthority? @relation("AuthorityCourses", fields: [certificationAuthorityId], references: [id], onDelete: SetNull)
  level     CertificationLevel?      @relation("LevelCourses", fields: [certificationLevelId], references: [id], onDelete: SetNull)
  department Department?             @relation("DepartmentCourses", fields: [departmentId], references: [id], onDelete: SetNull)

  courseCurricula CourseCurriculum[] @relation("CourseCurricula")
  units           Unit[]            @relation("CourseUnits")
  feeAssignments  CourseFeeAssignment[] @relation("CourseFeeAssignments")
  students        StudentProfile[]  @relation("CourseStudentProfiles")
  invoices        Invoice[]         @relation("CourseInvoices")

  @@index([departmentId, isActive, name])
  @@index([certificationAuthorityId, certificationLevelId, isActive])
  @@index([isActive, name])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("courses")
}

// Join between a course and a curriculum version. A course is "offered"
// through an active mapping; the unique pair guards against duplicates.
model CourseCurriculum {
  id           Int      @id @default(autoincrement())
  courseId     Int      @map("course_id")
  curriculumId Int      @map("curriculum_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int?     @map("created_by")
  updatedBy    Int?     @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course     Course     @relation("CourseCurricula", fields: [courseId], references: [id], onDelete: Cascade)
  curriculum Curriculum @relation("CurriculumCourseCurricula", fields: [curriculumId], references: [id], onDelete: Cascade)

  enrolments CourseEnrolment[] @relation("CourseEnrolments")
  invoices   Invoice[]         @relation("CurriculumInvoices")

  @@unique([courseId, curriculumId])
  @@index([courseId, isActive])
  @@index([curriculumId, isActive])
  @@map("course_curricula")
}

// Academic setup: units taught under a specific course + curriculum
// combination. A unit code is unique per (course, curriculum) pair, so the
// same unit can be re-created under another course+curriculum to share it.
model Unit {
  id            Int       @id @default(autoincrement())
  courseId      Int       @map("course_id")
  curriculumId  Int       @map("curriculum_id")
  code          String    @map("code") @db.VarChar(50)
  name          String    @map("name") @db.VarChar(255)
  description   String?   @map("description") @db.Text
  modulesTaught Int?      @map("modules_taught")
  taughtHours   Int?      @map("taught_hours")
  creditFactor  Decimal?  @map("credit_factor") @db.Decimal(10, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     Int?      @map("created_by")
  updatedBy     Int?      @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  course     Course     @relation("CourseUnits", fields: [courseId], references: [id], onDelete: Cascade)
  curriculum Curriculum @relation("CurriculumUnits", fields: [curriculumId], references: [id], onDelete: Cascade)

  timetables AcademicTimetable[] @relation("UnitTimetables")
  attendanceRecords ClassAttendance[] @relation("UnitAttendance")

  @@unique([courseId, curriculumId, code])
  @@index([courseId, curriculumId, isActive])
  @@index([isActive, name])
  @@index([createdAt])
  @@map("units")
}

// =============================================================

model StudentProfile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique @map("user_id")
  admissionNumber String? @unique @map("admission_number") @db.VarChar(50)
  nationalId    String?   @map("national_id") @db.VarChar(50)
  courseId      Int?      @map("course_id")
  level         Int?      @default(1)
  admDate       DateTime? @map("adm_date") @db.Date
  status        String?   @map("status") @db.VarChar(20)
  nextOfKinFirstName    String? @map("next_of_kin_first_name") @db.VarChar(100)
  nextOfKinLastName     String? @map("next_of_kin_last_name") @db.VarChar(100)
  nextOfKinPhone        String? @map("next_of_kin_phone") @db.VarChar(50)
  nextOfKinAltPhone     String? @map("next_of_kin_alt_phone") @db.VarChar(50)
  nextOfKinEmail        String? @map("next_of_kin_email") @db.VarChar(255)
  nextOfKinRelationship String? @map("next_of_kin_relationship") @db.VarChar(100)
  createdBy     Int?      @map("created_by")
  updatedBy     Int?      @map("updated_by")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course? @relation("CourseStudentProfiles", fields: [courseId], references: [id], onDelete: SetNull)

  courseEnrolments CourseEnrolment[] @relation("StudentEnrolments")
  invoices         Invoice[]         @relation("StudentInvoices")
  payments         Payment[]         @relation("StudentPayments")
  ledgerEntries    StudentLedgerEntry[] @relation("StudentLedger")
  attendanceRecords ClassAttendance[] @relation("StudentAttendance")

  @@index([courseId])
  @@index([deletedAt])
  @@index([nationalId])
  @@map("student_profiles")
}

// A student's admission into a course version (course + curriculum), tied to
// an optional academic session. Created during onboarding; a student may be
// re-enrolled (e.g. transfer) by adding a new row.
model CourseEnrolment {
  id                 Int       @id @default(autoincrement())
  studentId          Int       @map("student_id")
  courseCurriculumId Int       @map("course_curriculum_id")
  academicSessionId  Int?      @map("academic_session_id")
  academicYearId     Int?      @map("academic_year_id")
  enrolmentDate      DateTime  @map("enrolment_date") @db.Date
  entryLevel         Int       @default(1) @map("entry_level")
  status             EnrolmentStatus @default(ENROLLED) @map("status")
  remarks            String?   @map("remarks") @db.Text
  createdBy          Int?      @map("created_by")
  updatedBy          Int?      @map("updated_by")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  student          StudentProfile   @relation("StudentEnrolments", fields: [studentId], references: [id], onDelete: Cascade)
  courseCurriculum CourseCurriculum @relation("CourseEnrolments", fields: [courseCurriculumId], references: [id], onDelete: Cascade)
  academicSession  AcademicSession? @relation("SessionEnrolments", fields: [academicSessionId], references: [id], onDelete: SetNull)
  academicYear     AcademicYear?    @relation("YearEnrolments", fields: [academicYearId], references: [id], onDelete: SetNull)

  // A student keeps a history of enrolments (re-admission, transfer). At most
  // one ACTIVE (non-deleted, status ENROLLED) enrolment per student+course is
  // enforced in the service layer, not by a table-wide unique — a student may
  // legitimately re-enrol into the same course in a later session.
  @@index([studentId, courseCurriculumId, status])
  @@index([courseCurriculumId, status])
  @@index([academicSessionId, status])
  @@index([academicYearId, status])
  @@index([status, deletedAt, createdAt])
  @@map("course_enrolments")
}

// =============================================================
// CALENDAR & CLASSES (academic years/sessions, calendar events,
// timetables, lecture rooms, attendance)
// =============================================================

model AcademicYear {
  id          Int       @id @default(autoincrement())
  code        String    @unique @map("code") @db.VarChar(50)
  name        String    @map("name") @db.VarChar(255)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?   @map("description") @db.Text
  isActive    Boolean   @default(false) @map("is_active")
  createdBy   Int?      @map("created_by")
  updatedBy   Int?      @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions AcademicSession[] @relation("YearSessions")
  calendarEvents CalendarEvent[] @relation("YearCalendarEvents")
  feeAssignments CourseFeeAssignment[] @relation("YearFeeAssignments")
  enrolments CourseEnrolment[] @relation("YearEnrolments")
  invoices  Invoice[] @relation("YearInvoices")

  @@index([isActive])
  @@index([isActive, startDate])
  @@map("academic_years")
}

model AcademicSession {
  id             Int       @id @default(autoincrement())
  academicYearId Int       @map("academic_year_id")
  code           String    @map("code") @db.VarChar(50)
  name           String    @map("name") @db.VarChar(255)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  description    String?   @map("description") @db.Text
  isActive       Boolean   @default(false) @map("is_active")
  createdBy      Int?      @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  year          AcademicYear        @relation("YearSessions", fields: [academicYearId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]    @relation("SessionCalendarEvents")
  timetables    AcademicTimetable[] @relation("SessionTimetables")
  feeAssignments CourseFeeAssignment[] @relation("SessionFeeAssignments")
  enrolments    CourseEnrolment[]   @relation("SessionEnrolments")
  payments      Payment[]           @relation("SessionPayments")
  invoices      Invoice[]           @relation("SessionInvoices")
  ledgerEntries StudentLedgerEntry[] @relation("SessionLedgerEntries")

  @@unique([academicYearId, code])
  @@index([academicYearId, isActive])
  @@index([academicYearId, isActive, startDate])
  @@index([startDate])
  @@map("academic_sessions")
}

model CalendarEventType {
  id        Int      @id @default(autoincrement())
  code      String   @unique @map("code") @db.VarChar(50)
  label     String   @map("label") @db.VarChar(100)
  colorHex  String   @map("color_hex") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events CalendarEvent[] @relation("EventTypeEvents")

  @@map("calendar_event_types")
}

model CalendarEvent {
  id                Int       @id @default(autoincrement())
  academicYearId    Int       @map("academic_year_id")
  academicSessionId Int       @map("academic_session_id")
  eventTypeId       Int       @map("event_type_id")
  title             String    @map("title") @db.VarChar(255)
  description       String?   @map("description") @db.Text
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  source            String    @default("manual") @map("source") @db.VarChar(30)
  isLocked          Boolean   @default(false) @map("is_locked")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  year      AcademicYear      @relation("YearCalendarEvents", fields: [academicYearId], references: [id], onDelete: Cascade)
  session   AcademicSession   @relation("SessionCalendarEvents", fields: [academicSessionId], references: [id], onDelete: Cascade)
  eventType CalendarEventType @relation("EventTypeEvents", fields: [eventTypeId], references: [id], onDelete: Restrict)

  @@index([academicYearId, startDate])
  @@index([academicSessionId, startDate])
  @@index([academicSessionId, startDate, source, eventTypeId])
  @@index([eventTypeId])
  @@map("calendar_events")
}

model LectureRoom {
  id          Int       @id @default(autoincrement())
  name        String    @unique @map("name") @db.VarChar(255)
  code        String    @unique @map("code") @db.VarChar(50)
  capacity    Int?      @map("capacity")
  location    String?   @map("location") @db.VarChar(255)
  description String?   @map("description") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   Int?      @map("created_by")
  updatedBy   Int?      @map("updated_by")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  timetables AcademicTimetable[] @relation("RoomTimetables")

  @@index([isActive])
  @@index([deletedAt])
  @@map("lecture_rooms")
}

model AcademicTimetable {
  id                Int       @id @default(autoincrement())
  academicSessionId Int       @map("academic_session_id")
  unitId            Int       @map("unit_id")
  trainerStaffId    Int?      @map("trainer_staff_id")
  lectureRoomId     Int?      @map("lecture_room_id")
  dayOfWeek         Int       @map("day_of_week")
  startTime         DateTime  @map("start_time") @db.Time(6)
  endTime           DateTime  @map("end_time") @db.Time(6)
  type              String    @default("lecture") @map("type") @db.VarChar(30)
  recurrence        String    @default("weekly") @map("recurrence") @db.VarChar(30)
  date              DateTime? @map("date") @db.Date
  notes             String?   @map("notes") @db.Text
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  session      AcademicSession @relation("SessionTimetables", fields: [academicSessionId], references: [id], onDelete: Cascade)
  unit         Unit            @relation("UnitTimetables", fields: [unitId], references: [id], onDelete: Cascade)
  trainerStaff StaffProfile?   @relation("TrainerTimetables", fields: [trainerStaffId], references: [id], onDelete: SetNull)
  room         LectureRoom?    @relation("RoomTimetables", fields: [lectureRoomId], references: [id], onDelete: SetNull)

  @@index([academicSessionId, dayOfWeek])
  @@index([academicSessionId, dayOfWeek, startTime])
  @@index([trainerStaffId, dayOfWeek])
  @@index([trainerStaffId, dayOfWeek, startTime, endTime])
  @@index([lectureRoomId, dayOfWeek])
  @@index([lectureRoomId, dayOfWeek, startTime, endTime])
  @@index([unitId, academicSessionId])
  @@map("academic_timetables")
}

model ClassAttendance {
  id            Int       @id @default(autoincrement())
  unitId        Int       @map("unit_id")
  studentProfileId Int?   @map("student_profile_id")
  trainerProfileId Int?   @map("trainer_profile_id")
  sessionDate   DateTime  @map("session_date") @db.Date
  startTime     DateTime  @map("start_time") @db.Time(6)
  status        String    @map("status") @db.VarChar(20)
  remarks       String?   @map("remarks") @db.Text
  createdBy     Int?      @map("created_by")
  updatedBy     Int?      @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit           Unit           @relation("UnitAttendance", fields: [unitId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile? @relation("StudentAttendance", fields: [studentProfileId], references: [id], onDelete: SetNull)
  trainerProfile StaffProfile?   @relation("TrainerAttendance", fields: [trainerProfileId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, sessionDate, startTime])
  @@index([unitId, sessionDate])
  @@index([unitId, sessionDate, startTime])
  @@index([trainerProfileId, sessionDate])
  @@map("class_attendances")
}

// =============================================================
// AUTH: sessions, login attempts, otp, audit (new tables)
// =============================================================

model Session {
  id             Int       @id @default(autoincrement())
  sessionUuid    String    @unique @map("session_uuid") @db.Uuid
  userId         Int       @map("user_id")
  refreshTokenHash String? @map("refresh_token_hash") @db.Text
  deviceName     String?   @map("device_name") @db.VarChar(255)
  browser        String?   @db.VarChar(100)
  operatingSystem String?  @map("operating_system") @db.VarChar(100)
  ipAddress      String?   @map("ip_address") @db.VarChar(50)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@map("sessions")
}

model LoginAttempt {
  id           Int       @id @default(autoincrement())
  userId       Int?      @map("user_id")
  username     String    @db.VarChar(100)
  successful   Boolean   @default(false)
  ipAddress    String?   @map("ip_address") @db.VarChar(50)
  userAgent    String?   @map("user_agent") @db.Text
  failureReason String?  @map("failure_reason") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([username])
  @@map("login_attempts")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  userAgent   String?  @map("user_agent") @db.Text
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OtpCode {
  id             Int        @id @default(autoincrement())
  userId         Int        @map("user_id")
  codeHash       String     @map("code_hash") @db.VarChar(255)
  purpose        String     @db.VarChar(50)
  deliveryMethod String?    @map("delivery_method") @db.VarChar(50)
  destination    String?    @db.VarChar(255)
  attempts       Int        @default(0)
  maxAttempts    Int        @default(5)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(6)
  verifiedAt     DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// =============================================================
// FEES: reusable fee structures, their items, and per-course
// assignments (backend/prompt.txt). A FeeStructure is a reusable
// template; the CourseFeeAssignment table is the only thing that
// changes when a course/curriculum/year/session picks it up.
// =============================================================

enum FeeStatus {
  ACTIVE
  INACTIVE
}

model FeeStructure {
  id          Int        @id @default(autoincrement())
  feeName     String     @unique @map("fee_name") @db.VarChar(255)
  description String?    @map("description") @db.Text
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime?  @map("end_date") @db.Date
  status      FeeStatus  @default(ACTIVE)
  createdBy   Int?       @map("created_by")
  updatedBy   Int?       @map("updated_by")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  items       FeeItem[]              @relation("FeeStructureItems")
  assignments CourseFeeAssignment[]  @relation("FeeStructureAssignments")
  invoices    Invoice[]              @relation("StructureInvoices")

  @@index([status])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("fee_structures")
}

model FeeItem {
  id             Int      @id @default(autoincrement())
  feeStructureId Int      @map("fee_structure_id")
  itemName       String   @map("item_name") @db.VarChar(255)
  amount         Decimal  @db.Decimal(12, 2)
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  feeStructure FeeStructure @relation("FeeStructureItems", fields: [feeStructureId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[] @relation("InvoiceSourceItems")

  @@unique([feeStructureId, itemName])
  @@index([feeStructureId, displayOrder])
  @@map("fee_items")
}

model CourseFeeAssignment {
  id                Int       @id @default(autoincrement())
  courseId          Int       @map("course_id")
  curriculumId      Int       @map("curriculum_id")
  academicYearId    Int       @map("academic_year_id")
  academicSessionId Int       @map("academic_session_id")
  feeStructureId    Int       @map("fee_structure_id")
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  remarks           String?   @map("remarks") @db.Text
  status            FeeStatus @default(ACTIVE)
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  course          Course          @relation("CourseFeeAssignments", fields: [courseId], references: [id], onDelete: Restrict)
  curriculum      Curriculum      @relation("CurriculumFeeAssignments", fields: [curriculumId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear    @relation("YearFeeAssignments", fields: [academicYearId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation("SessionFeeAssignments", fields: [academicSessionId], references: [id], onDelete: Restrict)
  feeStructure    FeeStructure    @relation("FeeStructureAssignments", fields: [feeStructureId], references: [id], onDelete: Restrict)

  @@unique([courseId, curriculumId, academicYearId, academicSessionId, status, deletedAt])
  @@index([feeStructureId, status])
  @@index([academicSessionId, status])
  @@index([deletedAt])
  @@map("course_fee_assignments")
}

// =============================================================
// FINANCE: invoices, payments, and the student ledger. An invoice is a
// snapshot of what a student owes; a line item is either sourced from a
// frozen FeeItem (fee_structure billing) or free-form ad-hoc (fines, other
// charges). Payments allocate against invoices; every financial movement is
// mirrored into the double-entry student ledger.
// =============================================================

enum InvoiceType {
  FEES
  ADHOC
}

enum InvoiceStatus {
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum AdhocChargeType {
  FINE
  PENALTY
  HOSTEL
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  M_PESA
  CHEQUE
  CARD
  OTHER
}

enum LedgerEntryType {
  INVOICE
  INVOICE_REVERSAL
  PAYMENT
  PAYMENT_REVERSAL
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique @map("invoice_number") @db.VarChar(50)
  studentId          Int           @map("student_id")
  courseId           Int?          @map("course_id")
  courseCurriculumId Int?          @map("course_curriculum_id")
  curriculumId       Int?          @map("curriculum_id")
  academicYearId     Int?          @map("academic_year_id")
  academicSessionId  Int?          @map("academic_session_id")
  feeStructureId     Int?          @map("fee_structure_id")
  type               InvoiceType   @default(FEES) @map("type")
  chargeType         AdhocChargeType? @map("charge_type")
  status             InvoiceStatus @default(ISSUED) @map("status")
  amountDue          Decimal       @map("amount_due") @db.Decimal(12, 2)
  computedAmount     Decimal       @map("computed_amount") @db.Decimal(12, 2)
  issueDate          DateTime      @map("issue_date") @db.Date
  dueDate            DateTime      @map("due_date") @db.Date
  notes              String?       @map("notes") @db.Text
  reason             String?       @map("reason") @db.Text
  reversedAt         DateTime?     @map("reversed_at") @db.Timestamptz(6)
  reversedBy         Int?          @map("reversed_by")
  createdBy          Int?          @map("created_by")
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student          StudentProfile              @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  course           Course?                     @relation("CourseInvoices", fields: [courseId], references: [id], onDelete: SetNull)
  courseCurriculum CourseCurriculum?           @relation("CurriculumInvoices", fields: [courseCurriculumId], references: [id], onDelete: SetNull)
  curriculum       Curriculum?                 @relation("CurriculumInvoiceSource", fields: [curriculumId], references: [id], onDelete: SetNull)
  academicYear     AcademicYear?               @relation("YearInvoices", fields: [academicYearId], references: [id], onDelete: SetNull)
  academicSession  AcademicSession?            @relation("SessionInvoices", fields: [academicSessionId], references: [id], onDelete: SetNull)
  feeStructure     FeeStructure?               @relation("StructureInvoices", fields: [feeStructureId], references: [id], onDelete: SetNull)

  items            InvoiceItem[]               @relation("InvoiceItems")
  allocations      InvoicePaymentAllocation[]  @relation("InvoiceAllocations")
  ledgerEntries    StudentLedgerEntry[]        @relation("InvoiceLedgerEntries")

  @@index([studentId, status, issueDate])
  @@index([academicSessionId, status])
  @@index([academicYearId, status])
  @@index([feeStructureId, academicSessionId, status])
  @@index([status, dueDate])
  @@index([status])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  feeItemId   Int?    @map("fee_item_id")
  itemName    String  @map("item_name") @db.VarChar(255)
  description String? @map("description") @db.Text
  amount      Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)
  snapshot    Json?   @map("snapshot")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation("InvoiceItems", fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem FeeItem? @relation("InvoiceSourceItems", fields: [feeItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                Int           @id @default(autoincrement())
  studentId         Int?          @map("student_id")
  academicSessionId Int?          @map("academic_session_id")
  amount            Decimal       @db.Decimal(12, 2)
  paymentDate       DateTime      @map("payment_date") @db.Date
  method            PaymentMethod @map("method")
  reference         String?       @map("reference") @db.VarChar(100)
  status            PaymentStatus @default(COMPLETED) @map("status")
  reversedAt        DateTime?     @map("reversed_at") @db.Timestamptz(6)
  reversedBy        Int?          @map("reversed_by")
  reversalReason    String?       @map("reversal_reason") @db.VarChar(255)
  notes             String?       @map("notes") @db.Text
  createdBy         Int?          @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student          StudentProfile?           @relation("StudentPayments", fields: [studentId], references: [id], onDelete: SetNull)
  academicSession  AcademicSession?          @relation("SessionPayments", fields: [academicSessionId], references: [id], onDelete: SetNull)
  allocations      InvoicePaymentAllocation[] @relation("PaymentAllocations")
  ledgerEntries    StudentLedgerEntry[]      @relation("PaymentLedgerEntries")

  @@unique([studentId, reference])
  @@index([studentId, status, paymentDate])
  @@index([academicSessionId, status])
  @@index([status, paymentDate])
  @@index([status])
  @@map("payments")
}

model InvoicePaymentAllocation {
  id                Int      @id @default(autoincrement())
  paymentId         Int      @map("payment_id")
  invoiceId         Int      @map("invoice_id")
  academicSessionId Int?     @map("academic_session_id")
  amount            Decimal  @db.Decimal(12, 2)
  allocatedAt       DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)

  payment Payment @relation("PaymentAllocations", fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation("InvoiceAllocations", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentId])
  @@map("invoice_payment_allocations")
}

model StudentLedgerEntry {
  id                Int      @id @default(autoincrement())
  studentId         Int      @map("student_id")
  invoiceId         Int?     @map("invoice_id")
  paymentId         Int?     @map("payment_id")
  academicSessionId Int?     @map("academic_session_id")
  type              LedgerEntryType @map("type")
  debit             Decimal  @default(0) @db.Decimal(12, 2)
  credit            Decimal  @default(0) @db.Decimal(12, 2)
  reference         String?  @map("reference") @db.VarChar(100)
  description       String?  @map("description") @db.Text
  transactionDate   DateTime @map("transaction_date") @db.Date
  createdBy         Int?     @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student         StudentProfile?  @relation("StudentLedger", fields: [studentId], references: [id], onDelete: Cascade)
  invoice         Invoice?         @relation("InvoiceLedgerEntries", fields: [invoiceId], references: [id], onDelete: SetNull)
  payment         Payment?         @relation("PaymentLedgerEntries", fields: [paymentId], references: [id], onDelete: SetNull)
  academicSession AcademicSession? @relation("SessionLedgerEntries", fields: [academicSessionId], references: [id], onDelete: SetNull)

  @@index([studentId, transactionDate, id])
  @@index([studentId, transactionDate])
  @@index([studentId, academicSessionId])
  @@index([invoiceId])
  @@index([paymentId])
  @@map("student_ledger_entries")
}

model InvoiceSequence {
  id        Int @id @default(autoincrement())
  year      Int @unique @map("year")
  lastValue Int @default(0) @map("last_value")

  @@map("invoice_sequences")
}
